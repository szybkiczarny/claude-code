# Skopiuj ten plik jako .env i uzupełnij wartości
# cp .env.template .env

# Anthropic — Claude CLI trzyma klucz osobno po `claude login`
# Nie musisz tu nic wpisywać. Uruchom raz: claude login
# (jeśli wolisz podać ręcznie: odkomentuj poniżej)
# ANTHROPIC_API_KEY=sk-ant-...

# Telegram (opcjonalne — tylko jeśli chcesz bota)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Tavily — wyszukiwarka dla bota (opcjonalne)
# Darmowe konto: https://tavily.com
TAVILY_KEY=

# Konfiguracja
USER_NAME=Kuba
DASHBOARD_URL=http://192.168.1.34:8765
# CLAUDE_BIN=~/.local/bin/claude  # odkomentuj jeśli claude jest gdzie indziej
