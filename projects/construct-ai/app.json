{
  "expo": {
    "name": "Construct AI",
    "slug": "construct-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1729"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikacja potrzebuje kamery do zdjęć usterek."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Aplikacja potrzebuje mikrofonu do nagrywania raportów."
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.constructai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikacja potrzebuje kamery do zdjęć usterek.",
        "NSMicrophoneUsageDescription": "Aplikacja potrzebuje mikrofonu do nagrywania raportów."
      }
    },
    "android": {
      "package": "com.constructai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1729"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ce846357-a991-47f0-bbdd-75f1915a5023"
      }
    },
    "owner": "michalwalk10"
  }
}
